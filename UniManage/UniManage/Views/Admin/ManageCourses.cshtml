@model IEnumerable<UniManage.Models.Course>
@{
    ViewBag.Title = "Manage Courses";
}

<h2>Manage Courses</h2>

<p>@Html.ActionLink("Create Course", "CreateCourse", null, new { @class = "btn btn-primary" })</p>

<table class="table table-hover table-responsive">
    <thead>
        <tr>
            <th>Code</th>
            <th>Title</th>
            <th>Lecturer</th>
            <th>Capacity</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Code</td>
                <td>@c.Title</td>
                <td>@(c.Lecturer != null && c.Lecturer.User != null ? c.Lecturer.User.FullName : "TBA")</td>
                <td>@c.Capacity</td>
                <td>@(c.IsActive ? Html.Raw("<span class=\"badge badge-success\">Active</span>") : Html.Raw("<span class=\"badge badge-secondary\">Inactive</span>"))</td>
                <td>
                    @Html.ActionLink("Edit", "EditCourse", new { id = c.Id }, new { @class = "btn btn-outline-primary btn-sm" })
                    @Html.ActionLink("Delete", "DeleteCourse", new { id = c.Id }, new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>