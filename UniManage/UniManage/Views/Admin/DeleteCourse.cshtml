@model UniManage.Models.Course
@{
    ViewBag.Title = "Delete Course";
}

<h2>Delete Course</h2>

<div class="alert alert-danger">
    <strong>Warning:</strong> This will permanently delete the course.
</div>

<dl class="dl-horizontal">
    <dt>Code</dt>
    <dd>@Model.Code</dd>
    <dt>Title</dt>
    <dd>@Model.Title</dd>
    <dt>Lecturer</dt>
    <dd>@(Model.Lecturer != null && Model.Lecturer.User != null ? Model.Lecturer.User.FullName : "TBA")</dd>
</dl>

@using (Html.BeginForm("DeleteCourseConfirmed", "Admin", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    <button type="submit" class="btn btn-danger">Delete</button>
    @Html.ActionLink("Cancel", "ManageCourses", null, new { @class = "btn btn-default" })
}