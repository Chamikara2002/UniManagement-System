@model IEnumerable<UniManage.ViewModels.StudentPerformanceViewModel>
@{
    ViewBag.Title = "Student Performance";
}

<h2>Student Performance</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Student</th>
            <th>Username</th>
            <th>Average Score</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.StudentName</td>
                <td>@s.StudentUserName</td>
                <td>@String.Format("{0:0.00}", s.AverageScore)</td>
            </tr>
        }
    </tbody>
</table>

@section scripts {
    <script>
        var labels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Select(m => m.StudentName)));
        var values = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Select(m => m.AverageScore)));
        console.log(labels, values);
    </script>
}
