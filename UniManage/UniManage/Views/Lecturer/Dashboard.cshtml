@model UniManage.ViewModels.LecturerDashboardViewModel
@{
    ViewBag.Title = "Lecturer Dashboard";
}

<h2>Lecturer Dashboard</h2>

<div class="row">
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-title">Assigned Courses</div>
            <div class="stat text-primary">@Model.AssignedCoursesCount</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-title">Active Assignments</div>
            <div class="stat text-warning">@Model.ActiveAssignmentsCount</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-title">Pending Submissions</div>
            <div class="stat text-danger">@Model.PendingSubmissionsCount</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-title">Recent Submissions</div>
            <div class="stat">@Model.RecentSubmissions?.Count() ?? 0</div>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-md-12">
        <div class="card">
            <div class="card-title">Recent Submissions</div>
            @if (Model.RecentSubmissions != null && Model.RecentSubmissions.Any())
            {
                <table class="table table-hover table-condensed">
                    <thead>
                        <tr>
                            <th>Assignment</th>
                            <th>Student</th>
                            <th>Submitted On</th>
                            <th>Late</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.RecentSubmissions)
                        {
                            <tr>
                                <td>@s.Assignment?.Title</td>
                                <td>@s.Student?.User?.FullName</td>
                                <td>@s.SubmittedOn.ToLocalTime().ToString("g")</td>
                                <td>@(s.IsLate ? "<span class=\"badge badge-danger\">Late</span>" : "<span class=\"badge badge-success\">On time</span>")</td>
                                <td class="table-actions">@Html.ActionLink("Grade", "GradeSubmission", new { submissionId = s.Id }, new { @class = "btn btn-primary btn-sm" })</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No recent submissions.</p>
            }
        </div>
    </div>
</div>
