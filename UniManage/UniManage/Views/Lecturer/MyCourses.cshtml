@model IEnumerable<UniManage.Models.Course>
@{
    ViewBag.Title = "My Courses";
}

<h2>My Courses</h2>

@if (Model != null && Model.Any())
{
    <table class="table table-hover table-responsive">
        <thead>
            <tr>
                <th>Code</th>
                <th>Title</th>
                <th>Students</th>
                <th>Assignments</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Code</td>
                    <td>@Html.ActionLink(c.Title, "CourseDetails", new { id = c.Id })</td>
                    <td>@(c.Enrollments != null ? c.Enrollments.Count() : 0)</td>
                    <td>@(c.Assignments != null ? c.Assignments.Count() : 0)</td>
                    <td>
                        @Html.ActionLink("Materials", "CourseDetails", new { id = c.Id }, new { @class = "btn btn-outline-secondary btn-sm" })
                        @Html.ActionLink("Assignments", "Assignments", new { courseId = c.Id }, new { @class = "btn btn-outline-primary btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>You have no assigned courses.</p>
}