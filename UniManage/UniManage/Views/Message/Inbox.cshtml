@model IEnumerable<UniManage.Models.Message>
@{
    ViewBag.Title = "Inbox";
}

<h2>Inbox</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-hover">
    <table class="table table-hover table-responsive">
    <thead>
        <tr>
            <th>From</th>
            <th>Subject</th>
            <th>Received</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
                <tr class="@(m.IsRead ? "" : "table-info")">
                <td>@m.FromUser?.FullName</td>
                <td>@Html.ActionLink(m.Subject, "Details", new { id = m.Id })</td>
                <td>@m.SentOn.ToLocalTime().ToString("g")</td>
                    <td>@(m.IsRead ? "" : Html.Raw("<span class=\"badge badge-danger\">New</span>"))</td>
            </tr>
        }
    </tbody>
</table>