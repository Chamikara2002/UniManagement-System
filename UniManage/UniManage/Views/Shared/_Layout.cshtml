@using Microsoft.AspNet.Identity
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>UniManage - @ViewBag.Title</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <style>
        /* small improvements for dashboard cards */
        .card { border: 1px solid #e3e3e3; padding: 15px; border-radius: 4px; background: #fff; margin-bottom: 20px; }
        .card .card-title { font-size: 1.1em; margin-bottom: 10px; font-weight: 600; }
        .stat { font-size: 2.1em; font-weight: 700; }
        .table-actions { white-space: nowrap; }
    </style>
</head>
<body>
    <nav class="navbar navbar-inverse navbar-fixed-top">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#main-nav">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a class="navbar-brand" href="@Url.Action("Index", "Home")">UniManage</a>
            </div>

            <div class="collapse navbar-collapse" id="main-nav">
                <ul class="nav navbar-nav">
                    <li>@Html.ActionLink("Home", "Index", "Home")</li>
                    <li>@Html.ActionLink("Courses", "BrowseCourses", "Student")</li>
                    <li>@Html.ActionLink("Reports", "Index", "Report")</li>
                </ul>

                <form class="navbar-form navbar-left" role="search" action="@Url.Action("Index", "Home")">
                    <div class="form-group">
                        <input type="text" name="q" class="form-control input-sm" placeholder="Search courses, users..." />
                    </div>
                    <button type="submit" class="btn btn-default btn-sm">Search</button>
                </form>

                <ul class="nav navbar-nav navbar-right">
                    @if (Request.IsAuthenticated)
                    {
                        <li>@Html.ActionLink("Inbox", "Inbox", "Message")</li>
                        @if (User.IsInRole("Administrator"))
                        {
                            <li>@Html.ActionLink("Admin", "Index", "Admin")</li>
                        }
                        @if (User.IsInRole("Lecturer"))
                        {
                            <li>@Html.ActionLink("Lecturer", "Index", "Lecturer")</li>
                        }
                        @if (User.IsInRole("Student"))
                        {
                            <li>@Html.ActionLink("Student", "Index", "Student")</li>
                        }

                        <li class="dropdown">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown">@User.Identity.GetUserName() <b class="caret"></b></a>
                            <ul class="dropdown-menu">
                                <li>@Html.ActionLink("Profile", "Index", "Account")</li>
                                <li class="divider"></li>
                                <li>
                                    @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "navbar-form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-link">Log off</button>
                                    }
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li>@Html.ActionLink("Login", "Login", "Account")</li>
                        <li>@Html.ActionLink("Register", "Register", "Account")</li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container" style="margin-top:70px;">
        <div class="row">
            <div class="col-md-3 hidden-sm hidden-xs">
                @Html.Partial("_RoleSidebar")
            </div>
            <div class="col-md-9 col-sm-12">
                @RenderBody()
                <hr />
                <footer>
                    <p class="text-muted">&copy; @DateTime.Now.Year - UniManage &middot; Built for educational demo</p>
                </footer>
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
